# Copy this file to .env and fill in your own values. Never commit .env.
APP_NAME=antifaz
LOG_LEVEL=INFO

# Key your clients send as "Authorization: Bearer ..." (or "x-api-key" for Anthropic).
# Pick a long random value.
ANTIFAZ_API_KEY=change-me-antifaz-key
# Provider. The URL and the key are only read from here, never from the client.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me-provider-key
# Anthropic, without "/v1" at the end (same idea as ANTHROPIC_BASE_URL in the official SDKs).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=change-me-anthropic-key

UPSTREAM_TIMEOUT_SECONDS=120
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=4194304
