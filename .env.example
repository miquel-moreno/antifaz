# Copy this file to .env and fill in your own values. Never commit .env.
# Every variable starts with ANTIFAZ_ so it never mixes with the ones Claude Code or the SDKs
# use (ANTHROPIC_BASE_URL, OPENAI_API_KEY...) in the same shell.
# Antifaz refuses to start while any key still starts with "change-me".
ANTIFAZ_APP_NAME=antifaz
ANTIFAZ_LOG_LEVEL=INFO

# Key your clients send as "Authorization: Bearer ..." or "x-api-key".
# At least 32 printable ASCII characters, no spaces. For example: openssl rand -hex 32
ANTIFAZ_API_KEY=change-me-to-a-random-value-of-32-characters-or-more
# Providers. The URLs and the keys are only read from here, never from the client.
# A provider without a key answers 503 on its route.
ANTIFAZ_OPENAI_BASE_URL=https://api.openai.com/v1
ANTIFAZ_OPENAI_API_KEY=change-me-openai-provider-key
# Anthropic, without "/v1" at the end.
ANTIFAZ_ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTIFAZ_ANTHROPIC_API_KEY=change-me-anthropic-provider-key

# Host names clients use to reach Antifaz (the Host header), comma-separated. "*" is refused.
# In Docker or behind a reverse proxy, add the name clients use (e.g. antifaz,antifaz.internal).
ANTIFAZ_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Browser origins allowed on the proxy routes, comma-separated. Empty: every request with an
# Origin header is refused (403). "*" and "null" are refused. There is no CORS either way.
ANTIFAZ_ALLOWED_ORIGINS=

ANTIFAZ_UPSTREAM_TIMEOUT_SECONDS=120
ANTIFAZ_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
ANTIFAZ_MAX_BODY_BYTES=4194304
