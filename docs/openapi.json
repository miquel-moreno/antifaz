    "/v1/models": {
      "get": {
        "description": "The provider's model list, as the provider sends it. Provider errors pass as they are.",
        "operationId": "list_models_v1_models_get",
        "parameters": [
          {
            "description": "With it, the Anthropic list; without it, the OpenAI list.",
            "in": "header",
            "name": "anthropic-version",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Anthropic only: letters, digits, . _ : - (up to 200).",
            "in": "query",
            "name": "after_id",
            "required": false,
            "schema": {
              "pattern": "[A-Za-z0-9._:-]{1,200}",
              "type": "string"
            }
          },
          {
            "description": "Anthropic only: letters, digits, . _ : - (up to 200).",
            "in": "query",
            "name": "before_id",
            "required": false,
            "schema": {
              "pattern": "[A-Za-z0-9._:-]{1,200}",
              "type": "string"
            }
          },
          {
            "description": "Anthropic only.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
