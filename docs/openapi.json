{
  "components": {
    "schemas": {
      "Entity": {
        "properties": {
          "end": {
            "title": "End",
            "type": "integer"
          },
          "start": {
            "title": "Start",
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/EntityType"
          }
        },
        "required": [
          "type",
          "start",
          "end"
        ],
        "title": "Entity",
        "type": "object"
      },
      "EntityType": {
        "description": "Kinds of personal data. The definition order breaks exact ties in overlaps.",
        "enum": [
          "ES_DNI",
          "ES_NIE",
          "ES_NIF",
          "ES_CIF",
          "ES_NSS",
          "ES_CCC",
          "IBAN",
          "IT_CODICE_FISCALE",
          "EU_VAT",
          "CREDIT_CARD",
          "EMAIL",
          "IP",
          "PHONE",
          "ES_PASSPORT",
          "ES_PLATE",
          "ADDRESS",
          "DATE_OF_BIRTH",
          "PT_NIF",
          "FR_NIR",
          "DE_IDNR",
          "PERSON"
        ],
        "title": "EntityType",
        "type": "string"
      },
      "ErrorBody": {
        "description": "Every error of Antifaz itself: a stable code and a fixed message (OpenAPI only).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "ner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ner"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ScanResponse": {
        "properties": {
          "entities": {
            "items": {
              "$ref": "#/components/schemas/Entity"
            },
            "title": "Entities",
            "type": "array"
          }
        },
        "required": [
          "entities"
        ],
        "title": "ScanResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "antifaz",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/antifaz/scan": {
      "post": {
        "description": "Types and positions (`[start, end)`, in Unicode characters) of the personal data found.",
        "operationId": "scan_text_antifaz_scan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid request, or blocked to protect personal data (`antifaz_blocked`)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Missing or invalid Antifaz key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request from a browser origin that is not allowed"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Body too large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Content-Type is not application/json (UTF-8)"
          }
        },
        "summary": "Scan Text",
        "tags": [
          "antifaz"
        ]
      }
    },
    "/healthz": {
